{
  "name": "@moniflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @moniflow/moniguard build && tsc -p tsconfig.build.json",
    "dev": "node --watch --import tsx src/server.ts",
    "start": "node --import tsx src/server.ts",
    "start:prod": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.1",
    "@moniflow/moniguard": "workspace:*",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.0",
    "postgres": "^3.4.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5"
  }
}
