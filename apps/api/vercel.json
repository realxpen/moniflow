{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm run build && mkdir -p public",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api/index?__moniflow_path=:path*"
    }
  ]
}
