# MONIFlow — local shared-key BMONI sandbox lab
# Copy to apps/api/.env. NEVER commit the resulting .env file.
NODE_ENV=development
MONIFLOW_SHARED_KEY_LAB_ENABLED=true
MONIFLOW_SHARED_KEY_LAB_ALLOW_WRITES=false
# Keep the exact confirmation unset except while performing one manual action.
# MONIFLOW_SHARED_KEY_LAB_CONFIRM=

# Development host is enforced by the existing BMONI configuration code.
BMONI_BASE_URL=https://embedded-dev.bmoni.com
# Paste the CURRENT shared test key from the official BMONI quickstart locally.
# Do not store the key in GitHub, ChatGPT, public Expo env, or browser code.
BMONI_API_KEY=

# After manually creating/reconciling a documented BMONI test user:
# BMONI_LAB_USER_ID=

# Owner proof uses a *device-owned test wallet*. NEVER paste a private key.
# BMONI_LAB_OWNER_ADDRESS=
# BMONI_LAB_CHALLENGE_ID=
# BMONI_LAB_OWNER_PROOF_SIGNATURE=
# Keep all real partner onboarding disabled:
BMONI_PARTNER_ONBOARDING_ENABLED=false
