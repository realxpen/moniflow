{
  "expo": {
    "name": "MONIFlow",
    "slug": "moniflow",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "moniflow",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "./plugins/with-bmoni-sdk.js"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.realxpen.moniflow"
    },
    "android": {
      "package": "com.realxpen.moniflow"
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "xpen",
    "extra": {
      "eas": {
        "projectId": "3d986249-f72b-494b-9ceb-eef8335a5ae0"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
