NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
# Optional exact browser origins for CORS, comma-separated; defaults include the MONIFlow production site and local Expo web.
# CORS_ALLOWED_ORIGINS=https://moniflow-indol.vercel.app,http://localhost:8081

# Select the financial provider. Use moniflow-sandbox for deterministic local/demo flows.
# Switch back to bmoni for real BMONI sandbox verification.
FINANCIAL_PROVIDER=bmoni

# BMONI Embedded — sandbox only for hackathon
BMONI_BASE_URL=https://embedded-dev.bmoni.com
BMONI_API_KEY=
# Default false: prevent actual BMONI sandbox user creation with a shared key.
# Only set true after BMONI confirms a dedicated, authorized MONIFlow partner key.
BMONI_PARTNER_ONBOARDING_ENABLED=false
BMONI_REQUEST_TIMEOUT_MS=10000

# Production API must verify Supabase Auth JWTs (never expose keys or secrets).
# Use your Supabase project URL for issuer and the public JWKS endpoint.
# AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
# AUTH_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# AUTH_AUDIENCE=authenticated

# Public Supabase Auth client configuration (NOT the service-role secret).
# EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<supabase publishable/anon key>

# Mobile -> API
EXPO_PUBLIC_API_URL=http://localhost:4000

# Persistence
# For isolated MONIFlow sandbox development you can use:
# DATABASE_URL=file:./moniflow-sandbox.db
# Local/tests may still use SQLite:
# DATABASE_URL=file:./moniflow.db
# Deployed API should use a persistent Postgres URL (Supabase pooler recommended for serverless):
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
