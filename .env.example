NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000

# Select the financial provider. Use moniflow-sandbox for deterministic local/demo flows.
# Switch back to bmoni for real BMONI sandbox verification.
FINANCIAL_PROVIDER=bmoni

# BMONI Embedded — sandbox only for hackathon
BMONI_BASE_URL=https://embedded-dev.bmoni.com
BMONI_API_KEY=
BMONI_REQUEST_TIMEOUT_MS=10000

# Mobile -> API
EXPO_PUBLIC_API_URL=http://localhost:4000

# Persistence
# For isolated MONIFlow sandbox development you can use:
# DATABASE_URL=file:./moniflow-sandbox.db
# Local/tests may still use SQLite:
# DATABASE_URL=file:./moniflow.db
# Deployed API should use a persistent Postgres URL (Supabase pooler recommended for serverless):
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
